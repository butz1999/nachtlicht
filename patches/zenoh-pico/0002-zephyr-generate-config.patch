From: nachtlicht local integration
Subject: [PATCH] zephyr: generate zenoh-pico configuration header

The Zephyr module compiles zenoh-pico sources directly and therefore does not
run zenoh-pico's top-level CMakeLists.txt. Generate the required config.h in
the Zephyr build directory and map the module's Kconfig feature choices to it.
Remove this patch when zenoh-pico's Zephyr module performs the same setup.

diff --git a/zephyr/CMakeLists.txt b/zephyr/CMakeLists.txt
index 764adce..9026726 100644
--- a/zephyr/CMakeLists.txt
+++ b/zephyr/CMakeLists.txt
@@ -7,12 +7,51 @@ zephyr_library()
 function(configure_zenoh_feature config)
   string(REPLACE CONFIG_ZENOH_PICO Z_FEATURE feature ${config})
   if(${config})
+    set(${feature} 1 PARENT_SCOPE)
     zephyr_compile_definitions(${feature}=1)
   else()
+    set(${feature} 0 PARENT_SCOPE)
     zephyr_compile_definitions(${feature}=0)
   endif()
 endfunction()
 
+set(FRAG_MAX_SIZE 4096)
+set(BATCH_UNICAST_SIZE 2048)
+set(BATCH_MULTICAST_SIZE 2048)
+set(Z_CONFIG_SOCKET_TIMEOUT 100)
+set(Z_TRANSPORT_LEASE 10000)
+set(Z_TRANSPORT_LEASE_EXPIRE_FACTOR 3)
+set(Z_RUNTIME_MAX_TASKS 64)
+set(Z_RUNTIME_IDLE_READ_TASK_SLEEP 0)
+set(Z_TRANSPORT_ACCEPT_TIMEOUT 1000)
+set(Z_TRANSPORT_CONNECT_TIMEOUT 10000)
+set(Z_FEATURE_UNSTABLE_API 0)
+set(Z_FEATURE_CONNECTIVITY 0)
+set(Z_FEATURE_ADVANCED_PUBLICATION 0)
+set(Z_FEATURE_ADVANCED_SUBSCRIPTION 0)
+set(Z_FEATURE_LIVELINESS 1)
+set(Z_FEATURE_INTEREST 1)
+set(Z_FEATURE_LINK_BLUETOOTH 0)
+set(Z_FEATURE_LINK_SERIAL_USB 0)
+set(Z_FEATURE_LINK_TLS 0)
+set(Z_FEATURE_MULTICAST_TRANSPORT 1)
+set(Z_FEATURE_UNICAST_TRANSPORT 1)
+set(Z_FEATURE_FRAGMENTATION 1)
+set(Z_FEATURE_ENCODING_VALUES 1)
+set(Z_FEATURE_TCP_NODELAY 1)
+set(Z_FEATURE_LOCAL_SUBSCRIBER 0)
+set(Z_FEATURE_LOCAL_QUERYABLE 0)
+set(Z_FEATURE_SESSION_CHECK 1)
+set(Z_FEATURE_BATCHING 1)
+set(Z_FEATURE_BATCH_TX_MUTEX 0)
+set(Z_FEATURE_BATCH_PEER_MUTEX 0)
+set(Z_FEATURE_MATCHING 1)
+set(Z_FEATURE_RX_CACHE 0)
+set(Z_FEATURE_UNICAST_PEER 1)
+set(Z_FEATURE_AUTO_RECONNECT 1)
+set(Z_FEATURE_MULTICAST_DECLARATIONS 0)
+set(Z_FEATURE_ADMIN_SPACE 0)
+
 
 configure_zenoh_feature(CONFIG_ZENOH_PICO_LINK_SERIAL)
 configure_zenoh_feature(CONFIG_ZENOH_PICO_MULTI_THREAD)
@@ -27,6 +66,12 @@ configure_zenoh_feature(CONFIG_ZENOH_PICO_LINK_UDP_MULTICAST)
 configure_zenoh_feature(CONFIG_ZENOH_PICO_SCOUTING)
 configure_zenoh_feature(CONFIG_ZENOH_PICO_LINK_WS)
 
+set(zenoh_pico_generated_include "${PROJECT_BINARY_DIR}/zenoh-pico/include")
+file(MAKE_DIRECTORY "${zenoh_pico_generated_include}/zenoh-pico")
+configure_file(../include/zenoh-pico/config.h.in
+               "${zenoh_pico_generated_include}/zenoh-pico/config.h" @ONLY)
+zephyr_include_directories("${zenoh_pico_generated_include}")
+
 
 file(GLOB_RECURSE Sources
   "../src/api/*.c"
