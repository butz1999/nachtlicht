mainmenu "nachtlicht"

source "Kconfig.zephyr"

menu "nachtlicht"

config NACHTLICHT_WIFI_SSID
	string "Wi-Fi SSID"
	default ""
	help
	  SSID of the WPA2-PSK network used by the connectivity demonstration.

config NACHTLICHT_WIFI_PSK
	string "Wi-Fi pre-shared key"
	default ""
	help
	  WPA2 pre-shared key of the Wi-Fi network used by the connectivity
	  demonstration.

config NACHTLICHT_ZENOH_ROUTER
	string "Zenoh router TCP locator"
	default ""
	help
	  Explicit TCP locator of the Zenoh router, for example
	  tcp/192.168.1.42:7447. This is kept in the local zenoh.conf file
	  because the host address depends on the local network.

endmenu
