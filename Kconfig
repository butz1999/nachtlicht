mainmenu "nachtlicht"

source "Kconfig.zephyr"

menu "nachtlicht"

config NACHTLICHT_WIFI_SSID
	string "Wi-Fi SSID"
	default ""
	help
	  SSID of the WPA2-PSK network used by the connectivity demonstration.

config NACHTLICHT_WIFI_PSK
	string "Wi-Fi pre-shared key"
	default ""
	help
	  WPA2 pre-shared key of the Wi-Fi network used by the connectivity
	  demonstration.

config NACHTLICHT_ZENOH_P2P_PEER_LOCATOR
	string "Direct Zenoh peer locator"
	default ""
	help
	  TCP locator of the Dilbert peer used for the direct peer-to-peer
	  demonstration. Set it in the ignored zenoh.conf file.

endmenu
